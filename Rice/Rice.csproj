robocopy "$(TargetDir)." "%25PK%25\Rice" /E /NFL /NDL /NJH /NJS /NP /XD save mundo mapas backup backups /XF server.json.* *.sdf *.pdb *.log *.vshost.* *.json.bak "$(TargetDir)bots.json" "$(TargetDir)crews.json" "$(TargetDir)auction.json" "$(TargetDir)crew_ladder.json" "$(TargetDir)dome_points.json" "$(TargetDir)neo_dome_points.json" "$(TargetDir)neo_fire.json" "$(TargetDir)rush_spots.json" "$(TargetDir)friends.json" "$(TargetDir)licenses.json" "$(TargetDir)arbeit.json" "$(TargetDir)vsitems.json" "$(TargetDir)coupons.json" "$(TargetDir)level_docks.json" "$(TargetDir)alchemy.json" "$(TargetDir)carboxes.json" "$(TargetDir)visualboxes.json" "$(TargetDir)garage_v_fix.txt" "$(TargetDir)server.json" "$(TargetDir)Menu.bat"
